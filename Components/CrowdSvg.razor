@* CrowdSvg — Ringside bar crowd: tables, beer, raised arms, head bobs.
   Drawn entirely in SVG; no @Parameters so Blazor's diff never patches
   these nodes after the first render — CSS animations run uninterrupted.
   Two depth layers: a far back-row (heavier blur) and a near front-row
   (lighter blur) give a sense of depth without distracting from the fight.

   Coordinate system: ring first-rope is at y=200.  The crowd occupies the
   strip y=140–200, sitting ringside just above / behind the rope barrier.  *@

<defs>
    @* Near row: subtle soft-focus *@
    <filter id="cl-blur-near" x="-12%" y="-12%" width="124%" height="124%">
        <feGaussianBlur stdDeviation="1.1"/>
    </filter>
    @* Far row: more blurred, smaller figures feel further away *@
    <filter id="cl-blur-far" x="-18%" y="-18%" width="136%" height="136%">
        <feGaussianBlur stdDeviation="2.0"/>
    </filter>
</defs>

@* ── Venue atmosphere ─────────────────────────────────────────────────────── *@
@* Dark ceiling / back-wall above the ring *@
<rect x="150" y="136" width="600" height="66" fill="#080810"/>
@* Faint warm glow along the ring apron edge — light spilling upward *@
<rect x="155" y="192" width="590" height="10" fill="#c05010" opacity="0.10"/>

@* ── Far / back-row standing spectators (heavier blur, smaller) ───────────── *@
<g filter="url(#cl-blur-far)" opacity="0.68">

    @* Each back-row person: translate to (cx, base), head at cy−14, body cy−9..cy+3 *@

    @* BK1 — both arms raised *@
    <g transform="translate(255,178)">
        <rect x="-3.5" y="-9" width="7" height="12" fill="#181828"/>
        <circle cx="0" cy="-14" r="4" fill="#a07050"/>
        <rect class="cl-al cl-d4" x="-5.5" y="-8" width="2.5" height="8" fill="#181828" rx="1"/>
        <rect class="cl-ar cl-d4" x="3"    y="-8" width="2.5" height="8" fill="#181828" rx="1"/>
    </g>

    @* BK2 — right arm raised, head bob *@
    <g transform="translate(362,175)">
        <rect x="-3.5" y="-9" width="7" height="12" fill="#1a1820"/>
        <circle class="cl-hb cl-d6" cx="0" cy="-14" r="4" fill="#a07050"/>
        <rect x="-5.5" y="-8" width="2.5" height="8" fill="#1a1820" rx="1"/>
        <rect class="cl-ar cl-d6" x="3" y="-8" width="2.5" height="8" fill="#1a1820" rx="1"/>
    </g>

    @* BK3 — both arms raised (centre, visible) *@
    <g transform="translate(450,177)">
        <rect x="-3.5" y="-9" width="7" height="12" fill="#182018"/>
        <circle class="cl-hb cl-d9" cx="0" cy="-14" r="4" fill="#a07050"/>
        <rect class="cl-al cl-d9" x="-5.5" y="-8" width="2.5" height="8" fill="#182018" rx="1"/>
        <rect class="cl-ar cl-d9" x="3"    y="-8" width="2.5" height="8" fill="#182018" rx="1"/>
    </g>

    @* BK4 — right arm raised *@
    <g transform="translate(565,175)">
        <rect x="-3.5" y="-9" width="7" height="12" fill="#201818"/>
        <circle cx="0" cy="-14" r="4" fill="#a07050"/>
        <rect x="-5.5" y="-8" width="2.5" height="8" fill="#201818" rx="1"/>
        <rect class="cl-ar cl-d2" x="3" y="-8" width="2.5" height="8" fill="#201818" rx="1"/>
