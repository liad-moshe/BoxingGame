@* Referee figure — shown during KO count (Phase = RefereeCount) and clinch breaks. *@

@code {
    [Parameter, EditorRequired] public int   Count               { get; set; }
    [Parameter] public bool                  IsClinching         { get; set; }
    [Parameter] public int                   ClinchStage         { get; set; }
    [Parameter] public float                 ClinchStageProgress { get; set; }
    [Parameter] public float                 ClinchMidX          { get; set; } = 450f;

    private string Fmt(float v) => v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
    private static float Lerp(float a, float b, float t) => a + (b - a) * t;
}

@{
    // ── Clinch arm positions — computed once, used only when IsClinching ──────
    // Stage 0: both arms spread wide ("BREAK!" gesture).
    // Stage 1: left arm pushes P1 (left side) backward with growing aggression.
    // Stage 2: right arm pushes P2 (right side) backward.
    float laX2 = ClinchStage == 1 ? Lerp(-36f, -46f, ClinchStageProgress) : -36f;
    float laY2 = ClinchStage == 1 ? Lerp(-86f, -70f, ClinchStageProgress) : -86f;
    float raX2 = ClinchStage == 2 ? Lerp( 36f,  46f, ClinchStageProgress) :  36f;
    float raY2 = ClinchStage == 2 ? Lerp(-86f, -70f, ClinchStageProgress) : -86f;
}

@if (IsClinching)
{
    @* Referee stands between the fighters at their midpoint *@
    <g transform="translate(@Fmt(ClinchMidX), 378)">
        <circle cx="0" cy="-118" r="14" fill="#f5cba7" stroke="#333" stroke-width="2" />
        <rect x="-9" y="-104" width="18" height="36" fill="white" stroke="#333" stroke-width="1.5" rx="2" />
        @* Left arm — stage 1: gestures P1 to step back *@
        <line x1="-9" y1="-96" x2="@Fmt(laX2)" y2="@Fmt(laY2)"
              stroke="#333" stroke-width="3" stroke-linecap="round" />
        @* Right arm — stage 2: gestures P2 to step back *@
        <line x1="9"  y1="-96" x2="@Fmt(raX2)" y2="@Fmt(raY2)"
              stroke="#333" stroke-width="3" stroke-linecap="round" />
        <line x1="-4" y1="-68" x2="-8"  y2="-34" stroke="#333" stroke-width="3" stroke-linecap="round" />
        <line x1="4"  y1="-68" x2="8"   y2="-34" stroke="#333" stroke-width="3" stroke-linecap="round" />
    </g>

    @* "BREAK!" label sits below the HUD bars, above the boxers *@
    <SvgText X="@Fmt(ClinchMidX)" Y="185" FontSize="20" Fill="#f1c40f" FontFamily="monospace"
             FontWeight="bold" TextAnchor="middle" Stroke="#333" StrokeWidth="1">BREAK!</SvgText>
}
else
{
    @* KO count — referee at ring centre with raised counting arm *@
    <g transform="translate(450, 378)">
        <circle cx="0" cy="-118" r="14" fill="#f5cba7" stroke="#333" stroke-width="2" />
        <rect x="-9" y="-104" width="18" height="36" fill="white" stroke="#333" stroke-width="1.5" rx="2" />
        <line x1="-9"  y1="-96" x2="-30" y2="-120" stroke="#333" stroke-width="3" stroke-linecap="round" />
        <line x1="9"   y1="-96" x2="28"  y2="-80"  stroke="#333" stroke-width="3" stroke-linecap="round" />
        <line x1="-4"  y1="-68" x2="-8"  y2="-34"  stroke="#333" stroke-width="3" stroke-linecap="round" />
        <line x1="4"   y1="-68" x2="8"   y2="-34"  stroke="#333" stroke-width="3" stroke-linecap="round" />
    </g>

    <SvgText X="450" Y="160" FontSize="48" Fill="white" FontFamily="monospace" FontWeight="bold"
             TextAnchor="middle" Stroke="#333" StrokeWidth="1">@Count</SvgText>
    <SvgText X="450" Y="200" FontSize="18" Fill="#eee" FontFamily="monospace" TextAnchor="middle">...</SvgText>
}
